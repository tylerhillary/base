# ---------------------------------------------------------------------------
# Copy to .env.local and fill in your Firebase project details.
# NEXT_PUBLIC_* is inlined into the browser bundle; everything else is
# server-only and never reaches the client.
# ---------------------------------------------------------------------------

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Firebase Web SDK (browser: auth + realtime chat) ---
# Project settings -> General -> Your apps -> SDK setup and configuration
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# --- Firebase Admin SDK (server: Firestore reads/writes, session cookies) ---
# Project settings -> Service accounts -> Generate new private key
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Keep the surrounding quotes; the \n escapes are unescaped at runtime.
FIREBASE_PRIVATE_KEY=""

# Uncomment to point the server at a local emulator instead of live Firestore.
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
